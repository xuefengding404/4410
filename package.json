{
  "name": "starry-theater",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "星语剧场 Starry Theater — 纯本地 BYOK 视觉小说框架",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "assets": "python scripts/generate_assets.py",
    "prepare:ella": "python scripts/prepare_ella.py",
    "mock": "node scripts/mock-api.mjs",
    "shot": "node scripts/shot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
    "e2e:sprite": "node scripts/e2e-sprite.mjs",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/build-tauri.ps1",
    "shots": "node scripts/shots-review.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.12.6",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
